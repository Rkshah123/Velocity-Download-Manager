<Window x:Class="Velocity.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add download" Width="960" Height="640" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Velocity.App;component/icon.ico" ShowInTaskbar="False">
    <Border Margin="12" Padding="18" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="0,0,2,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <Path Data="{StaticResource IconDownload}" Width="17" Height="17" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <TextBlock Text="New download" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Paste direct HTTP or HTTPS links, one per line."
                                   Margin="0,2,0,0" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="FILE URL(S)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="UrlTextBox" Style="{StaticResource InputBoxStyle}" Height="88" Margin="0,5,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                         HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Padding="10,7"/>
                <TextBlock Text="One link per line — every link becomes its own download."
                           Style="{StaticResource CaptionStyle}" FontSize="9.5" TextWrapping="Wrap" Margin="2,4,0,0"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FILE NAME (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="FileNameTextBox" Style="{StaticResource InputBoxStyle}" Height="32" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DESTINATION FOLDER" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderTextBox" Style="{StaticResource InputBoxStyle}" Height="32"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseClick" Margin="6,0,0,0" Padding="11,0" Height="32"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="REFERER (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="RefererTextBox" Style="{StaticResource InputBoxStyle}" Height="30" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COOKIES (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="CookiesTextBox" Style="{StaticResource InputBoxStyle}" Height="30" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MIRROR URLS (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="MirrorsTextBox" Style="{StaticResource InputBoxStyle}" Height="54" Margin="0,5,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                                 HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Padding="10,7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="EXTRA HEADERS (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="HeadersTextBox" Style="{StaticResource InputBoxStyle}" Height="54" Margin="0,5,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                                 HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Padding="10,7"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mirrors must serve the identical file; headers go one Name: value per line and are sent with every request, including resumes."
                           Style="{StaticResource CaptionStyle}" FontSize="9.5" TextWrapping="Wrap" Margin="2,4,0,0"/>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="9"
                        Padding="12,8" Margin="0,10,0,0">
                    <TextBlock x:Name="ErrorTextBlock" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelClick"
                            Padding="16,7" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Start download" Style="{StaticResource PrimaryButtonStyle}" Click="StartClick"
                            Padding="18,7" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
