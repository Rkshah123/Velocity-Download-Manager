<Window x:Class="Velocity.App.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove download" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Velocity.App;component/small.png" ShowInTaskbar="False">
    <Border Margin="18" Padding="24" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconTile" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource DangerSoftBrush}"
                        VerticalAlignment="Top">
                    <Path x:Name="IconPath" Data="{StaticResource IconDelete}" Width="18" Height="18" Stretch="Uniform"
                          Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="HeadingText" Text="Remove download" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CaptionText" Text="This removes the entry from Velocity. Choose whether the file should go too."
                               TextWrapping="Wrap" Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"/>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12.5"/>
            </Border>

            <Border x:Name="DetailPanel" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Border>

            <CheckBox x:Name="DeleteFileBox" Content="Also delete the downloaded file from disk"
                      Margin="0,0,0,20" IsChecked="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelClick"
                        Padding="16,9" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Remove" Style="{StaticResource DangerButtonStyle}" Click="DeleteClick"
                        Padding="18,9" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
