<Window x:Class="Velocity.App.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Velocity.App"
        Title="Velocity" Width="960" Height="640" MinWidth="420" MinHeight="330"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Velocity.App;component/icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardAltBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConnectionRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="12,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ConnectionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" SharedSizeGroup="ConnIndex"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150" SharedSizeGroup="ConnBytes"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="{Binding Downloaded}" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Caption ═══ -->
        <Grid Grid.Row="0" Background="{DynamicResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
                <Image Source="pack://application:,,,/Velocity.App;component/small.png" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock x:Name="CaptionText" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeClick"
                        ToolTip="Minimize">
                    <Path Data="M0,0 L12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeClick"
                        ToolTip="Maximize">
                    <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L10.5,0.5 L10.5,10.5 L0.5,10.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseClick" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- ═══ Big window ═══ -->
            <Grid x:Name="ExpandedLayout" Margin="14,6,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="104" Height="104" VerticalAlignment="Top">
                        <local:ProgressRing x:Name="Ring" TrackBrush="{DynamicResource TrackBrush}"
                                            FillBrush="{DynamicResource AccentBrush}" StrokeWidth="7"/>
                        <TextBlock x:Name="RingText" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,4,0,0">
                        <TextBlock x:Name="NameText" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StateText" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>

                        <Grid Margin="0,16,0,0">
                            <TextBlock x:Name="DownloadedText" FontSize="12"/>
                            <TextBlock x:Name="SizeText" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>

                        <ProgressBar x:Name="Bar" Height="6" Margin="0,7,0,0"/>

                        <Grid Margin="0,9,0,0">
                            <TextBlock x:Name="SpeedText" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="LeftText" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,12">
                    <Button Content="Less" Style="{StaticResource GhostButtonStyle}" Click="ToggleLayoutClick"
                            Padding="16,7" HorizontalAlignment="Left" ToolTip="Show the small window"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="SpeedLimitClick"
                                Padding="12,7" Margin="0,0,8,0" ToolTip="Limit how fast this file downloads">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGauge}" Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                <TextBlock Text="Speed limit" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Hide" Style="{StaticResource SecondaryButtonStyle}" Click="HideClick"
                                Padding="20,7" Margin="0,0,8,0" ToolTip="Hide the window, keep downloading"/>
                        <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource PrimaryButtonStyle}"
                                Click="PauseResumeClick" Padding="24,7" MinWidth="92"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" SharedSizeGroup="ConnIndex"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150" SharedSizeGroup="ConnBytes"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="Downloaded" Style="{StaticResource SectionLabelStyle}"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="ConnectionsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Padding="0" ItemTemplate="{StaticResource ConnectionTemplate}"
                                 ItemContainerStyle="{StaticResource ConnectionRowStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Small window ═══ -->
            <Grid x:Name="CompactLayout" Margin="12,4,12,12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="76" Height="76" VerticalAlignment="Top">
                        <local:ProgressRing x:Name="RingC" TrackBrush="{DynamicResource TrackBrush}"
                                            FillBrush="{DynamicResource AccentBrush}" StrokeWidth="6"/>
                        <TextBlock x:Name="RingTextC" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,2,0,0">
                        <TextBlock x:Name="NameTextC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StateTextC" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="DownloadedTextC" FontSize="11.5"/>
                            <TextBlock x:Name="SizeTextC" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>

                        <ProgressBar x:Name="BarC" Height="5" Margin="0,6,0,0"/>

                        <Grid Margin="0,7,0,0">
                            <TextBlock x:Name="SpeedTextC" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="LeftTextC" FontSize="11.5" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="More" Style="{StaticResource GhostButtonStyle}" Click="ToggleLayoutClick"
                            Padding="14,6" ToolTip="Show the big window"/>
                    <Button Grid.Column="2" Content="Hide" Style="{StaticResource SecondaryButtonStyle}"
                            Click="HideClick" Padding="14,6" Margin="0,0,6,0"
                            ToolTip="Hide the window, keep downloading"/>
                    <Button Grid.Column="3" x:Name="PauseButtonC" Content="Pause"
                            Style="{StaticResource PrimaryButtonStyle}" Click="PauseResumeClick" Padding="16,6"
                            MinWidth="74"/>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" SharedSizeGroup="ConnIndex"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104" SharedSizeGroup="ConnBytes"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="Downloaded" Style="{StaticResource SectionLabelStyle}"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="ConnectionsListC" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Padding="0" ItemTemplate="{StaticResource ConnectionTemplate}"
                                 ItemContainerStyle="{StaticResource ConnectionRowStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
