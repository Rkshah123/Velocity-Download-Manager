<Window x:Class="Velocity.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="600" SizeToContent="Height" MaxHeight="780" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Velocity.App;component/icon.ico" ShowInTaskbar="False">
    <Border Margin="18" Padding="24" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="9"
                        Padding="12,9" Margin="0,16,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                               TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelClick"
                            Padding="18,9" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Save changes" Style="{StaticResource PrimaryButtonStyle}" Click="SaveClick"
                            Padding="20,9" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource CardAltBrush}"
                            VerticalAlignment="Top">
                        <Path Data="{StaticResource IconSettings}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                        <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Download behavior, storage and appearance" Margin="0,4,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Appearance -->
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,8"/>
                        <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="MidnightCard" Style="{StaticResource ThemeCardStyle}" GroupName="Theme"
                                                 Content="Midnight" Margin="0,0,8,0" Checked="ThemeCardChecked">
                                        <RadioButton.Tag>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#141823" Offset="0"/>
                                                <GradientStop Color="#5B8CFF" Offset="0.58"/>
                                                <GradientStop Color="#7C6BFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton x:Name="EmberCard" Style="{StaticResource ThemeCardStyle}" GroupName="Theme"
                                                 Content="Ember" Margin="0,0,8,0" Checked="ThemeCardChecked">
                                        <RadioButton.Tag>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#221A16" Offset="0"/>
                                                <GradientStop Color="#E8792F" Offset="0.58"/>
                                                <GradientStop Color="#F2A03D" Offset="1"/>
                                            </LinearGradientBrush>
                                        </RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton x:Name="LightCard" Style="{StaticResource ThemeCardStyle}" GroupName="Theme"
                                                 Content="Light" Checked="ThemeCardChecked">
                                        <RadioButton.Tag>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F7FAFE" Offset="0"/>
                                                <GradientStop Color="#3B6FD4" Offset="0.58"/>
                                                <GradientStop Color="#6A7BF0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </RadioButton.Tag>
                                    </RadioButton>
                                </UniformGrid>
                                <TextBlock Text="Pick a theme to preview it instantly across every Velocity window. Cancel restores the previous one."
                                           Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="2,9,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Storage -->
                        <TextBlock Text="STORAGE" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,8"/>
                        <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Default download folder" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FolderBox" Style="{StaticResource InputBoxStyle}"
                                             Background="{DynamicResource CardBrush}"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseClick" Margin="8,0,0,0" Padding="16,0" Height="40"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Transfers -->
                        <TextBlock Text="TRANSFERS" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,8"/>
                        <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Active downloads at once (0 = no limit)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="MaxBox" Style="{StaticResource InputBoxStyle}"
                                             Background="{DynamicResource CardBrush}"/>
                                    <TextBlock Text="0 lets every transfer you start run at the same time."
                                               Style="{StaticResource CaptionStyle}" FontSize="10.5"
                                               Margin="2,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Connections per download" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ConnectionsBox" Style="{StaticResource InputBoxStyle}"
                                             Background="{DynamicResource CardBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="Automatic retries" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RetriesBox" Style="{StaticResource InputBoxStyle}"
                                             Background="{DynamicResource CardBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="Speed limit (MB/s, 0 = unlimited)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SpeedBox" Style="{StaticResource InputBoxStyle}"
                                             Background="{DynamicResource CardBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Notifications -->
                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionLabelStyle}" Margin="2,0,0,8"/>
                        <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="16">
                            <StackPanel>
                                <CheckBox x:Name="NotificationsBox" Content="Notify me when a download finishes or fails"/>
                                <TextBlock Text="Notifications appear from the Velocity tray icon and never interrupt a transfer."
                                           Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="29,6,0,0"/>
                                <CheckBox x:Name="ClipboardBox" Content="Offer a link copied to the clipboard" Margin="0,14,0,0"/>
                                <TextBlock Text="When a copied link is a downloadable file, Velocity asks once before adding it. Only while this window is open."
                                           Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="29,6,0,0"/>
                                <CheckBox x:Name="StartupBox" Content="Start Velocity when Windows starts" Margin="0,14,0,0"/>
                                <TextBlock Text="Keeps the browser integration ready, so a video or a file can be sent to Velocity without launching it first."
                                           Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="29,6,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ResumeBox" Content="Continue unfinished downloads when Velocity starts" Margin="0,14,0,0"/>
                                <TextBlock Text="Off by default, so opening Velocity never starts a transfer or writes files by itself. Paused downloads stay in the list until you press Resume."
                                           Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="29,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
