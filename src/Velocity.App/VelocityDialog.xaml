<Window x:Class="Velocity.App.VelocityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velocity" Width="470" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Velocity.App;component/small.png" ShowInTaskbar="False">
    <Border Margin="16" Padding="22" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconTile" Width="38" Height="38" CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                    <Path x:Name="IconPath" Width="18" Height="18" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="HeadingText" Text="Velocity" FontSize="19" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="CaptionText" Text="" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,0,0,12">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Border>

            <Border x:Name="DetailPanel" Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="11"
                           FontFamily="Cascadia Mono, Consolas, Segoe UI"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelClick" Padding="16,9" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OkClick" Padding="20,9" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
