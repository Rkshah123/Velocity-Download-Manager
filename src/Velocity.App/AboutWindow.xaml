<Window x:Class="Velocity.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Velocity" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Velocity.App;component/icon.ico" ShowInTaskbar="False">
    <Border Margin="18" Padding="26" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="15" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="V" FontSize="29" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Velocity" FontSize="25" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="7" Padding="8,3"
                                Margin="10,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Native Windows download manager" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>

            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19"
                       Foreground="{DynamicResource SecondaryTextBrush}">
                Velocity streams files over HTTP and HTTPS with resumable transfers, multi-connection segmentation,
                a persistent queue, scheduling and direct browser capture.
            </TextBlock>

            <TextBlock Text="WHAT IT DOES" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,10"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0"
                              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Resumable downloads" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0"
                              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Multi-connection transfers" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0"
                              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Pause, retry and recovery" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0"
                              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Queue and scheduler" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0"
                              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Chrome, Edge and Firefox capture" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,9,0"
                              Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Local SQLite history" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Developer" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="Shahrukh Khan" FontSize="11.5" FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" Click="CloseClick"
                    HorizontalAlignment="Right" Padding="22,9" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
